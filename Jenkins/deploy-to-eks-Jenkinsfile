pipeline{
    agent any
    stages {
        stage('Checkout from Git'){
            steps{
                git branch: 'main', url: 'https://github.com/gyenoch/Fullstack-Bank-App.git'
            }
        }

        stage('Terraform version'){
             steps{
                 sh 'terraform --version'
             }
        }

        stage('Initializing Terraform'){
             steps{
                 dir('Eks-terraform') {
                      sh 'terraform init'
                   }
             }
        }

        stage('Formating terraform Code'){
            steps{
                sh 'terraform fmt'
            }
        }

        stage('Terraform validate'){
             steps{
                 dir('Eks-terraform') {
                      sh 'terraform validate'
                   }
             }
        }

        stage('Previewing the Infra using Terraform'){
             steps{
                 dir('Eks-terraform') {
                      sh 'terraform plan'
                   }
             }
        }
        stage('Terraform apply/destroy'){
             steps{
                 dir('Eks-terraform') {
                      sh 'terraform ${action} --auto-approve'
                   }
             }
        }

        stage('Deploying Chatbot Application') {
            steps{
                script{
                    dir('k8s') {
                        sh 'aws eks update-kubeconfig --name EKS_CLOUD --region us-east-1'
                        sh 'kubectl apply -f postgres-deployment.yaml'  // --validate=false
                        sh 'kubectl apply -f backend-deployment.yaml'
                        sh 'kubectl apply -f frontend-deployment.yaml'
                    }
                }
            }
        }
    }
}